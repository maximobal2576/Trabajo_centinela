# -*- coding: utf-8 -*-
"""
===============================================================================
PROYECTO CENTINELA v2 - BASTÓN TÉCNICO INTELIGENTE MONOLÍTICO DE PRODUCCIÓN
MACRO MAESTRO PARA FREECAD (.FCMacro)
===============================================================================
Innovaciones de Ingeniería Integrada:
 1. Mango Ergonómico Monolítico (Tramo 1):
    - Empuñadura anatómica integrada (sin cajas externas acopladas).
    - Cavidad axial protegida para 2x Baterías 18650 en serie + BMS 2S.
    - Bahía central para ESP32-WROOM y módulo IMU MPU-6050 con montaje flotante.
    - 3 Nichos hápticos para motores de vibración (dedo índice, pulgar y palma).
    - Cavidad integrada para Pulsador SOS y puerto de recarga.
 2. Torreta Monolítica de Sensores Ultrasónicos:
    - Sensor Frontal integrado (2 orificios de 16.2 mm a 26 mm de centro).
    - Sensor Suelo integrado a 45° hacia el pavimento (pozos y desniveles).
    - Alojamiento integrado para Servo SG90 de radar rotativo.
 3. Conicidad Progresiva del Bastón (Efecto varilla de movilidad):
    - Tramo 1 (Mango/Sensores): Ø 32 -> 26 mm
    - Tramo 2 (Intermedio Alto): Ø 24 -> 21 mm
    - Tramo 3 (Intermedio Alerta): Ø 20 -> 17.5 mm
    - Tramo 4 (Base Inferior): Ø 16.5 -> 14 mm (ultraligero en punta)
 4. Desacople Dinámico y Aislamiento de Vibraciones:
    - Cámara de choque acústico en puntera de desgaste.
    - Silentblocks elastoméricos O-ring NBR en cada unión macho-hembra.
    - Gargantas para juntas tóricas de desacople en transductores ultrasónicos.
===============================================================================
"""

import FreeCAD as App
import Part
import math
import os

try:
    import Mesh
except ImportError:
    Mesh = None

# =============================================================================
# 1. PARÁMETROS MAESTROS DE INGENIERÍA
# =============================================================================
# Longitudes Axiales (mm)
L_MANGO               = 320.0    # Longitud total del Tramo 1 (Empuñadura + Torreta)
L_TRAMO_2             = 295.0    # Tramo 2 Intermedio Alto
L_TRAMO_3             = 295.0    # Tramo 3 Intermedio Alerta (Rojo RAL 3020)
L_TRAMO_4             = 260.0    # Tramo 4 Base Inferior
L_PUNTERA             = 35.0     # Puntera Bumper
L_TOTAL               = 1200.0   # Longitud total ensamblada

# Perfil Conico Progresivo (Diametros Exteriores en mm)
D_MANGO_TOP           = 32.0     # Empuñadura superior ergonómica
D_MANGO_BOT           = 26.0     # Base del Tramo 1
D_T2_TOP              = 24.0     # Entrada Tramo 2
D_T2_BOT              = 21.0     # Salida Tramo 2
D_T3_TOP              = 20.0     # Entrada Tramo 3
D_T3_BOT              = 17.5     # Salida Tramo 3
D_T4_TOP              = 16.5     # Entrada Tramo 4
D_T4_BOT              = 14.0     # Extremo de acople con puntera

# Espesor de Pared Estructural
T_WALL_MANGO          = 2.8      # Mayor rigidez en zona de componentes (mm)
T_WALL_TUBOS          = 2.0      # Espesor optimizado para tramos inferiores (mm)

# Dimensiones de Componentes Centinela
D_BAT_18650           = 19.5     # Diámetro de cavidad para celdas 18650 (mm)
L_BAT_BAY             = 138.0    # Longitud para 2 celdas en serie + resortes
D_ULTRASONIC_EYE      = 16.2     # Diámetro transductores HC-SR04 (mm)
DIST_ULTRASONIC_EYES  = 26.0     # Distancia entre centros de transductores
D_HAPTIC_MOTOR        = 10.5     # Diámetro motores de vibración tipo moneda (mm)
D_PIN                 = 5.0      # Diámetro nominal del pasador
CLEARANCE_PIN         = 0.25     # Holgura FDM taladro (+0.25 mm)

# Acoples y Uniones Taper-Lock
L_SOLAPE              = 38.0     # Longitud de espiga macho (mm)
H_TAPER               = 3.0      # Hombro cónico a 30 grados
CLEARANCE_FIT         = 0.30     # Holgura radial

# Rutas de Salida
DIR_CAD = os.path.dirname(os.path.abspath(__file__)) if "__file__" in locals() else "C:\\Users\\admin\\Documents\\proyecto innovador\\versiones\\Centinela_v2\\cad"
if not os.path.exists(DIR_CAD):
    os.makedirs(DIR_CAD)

print(">> Inicializando Sistema Maestro Centinela v2 Monolítico...")

DOC_NAME = "Centinela_v2_Monolitico_Final"
try:
    App.closeDocument(DOC_NAME)
except Exception:
    pass

doc = App.newDocument(DOC_NAME)
App.setActiveDocument(DOC_NAME)

# =============================================================================
# 2. CONSTRUCCIÓN DEL TRAMO 1: MANGO ERGONÓMICO Y TORRETA DE SENSORES
# =============================================================================
print(">> Modelando Tramo 1: Mango Ergonómico con Bahías de Electrónica y Sensores...")

# Cuerpo cónico exterior del Tramo 1
r1_top = D_MANGO_TOP / 2.0  # 16.0 mm
r1_bot = D_MANGO_BOT / 2.0  # 13.0 mm
mango_solido = Part.makeCone(r1_bot, r1_top, L_MANGO)

# 1. Cavidad Axial para Pack 2S de Baterías 18650 (en la parte superior del mango)
cavidad_baterias = Part.makeCylinder(D_BAT_18650 / 2.0, L_BAT_BAY)
cavidad_baterias.translate(App.Vector(0, 0, L_MANGO - L_BAT_BAY - 10.0))
mango_solido = mango_solido.cut(cavidad_baterias)

# 2. Bahía Central para ESP32-WROOM y BMS 2S
caja_esp32 = Part.makeBox(28.0, 14.0, 55.0)
caja_esp32.translate(App.Vector(-14.0, -7.0, L_MANGO - L_BAT_BAY - 70.0))
mango_solido = mango_solido.cut(caja_esp32)

# 3. Nichos para 3 Motores Hápticos de Vibración (Palma, Índice, Pulgar)
for z_pos, ang_deg in [(L_MANGO - 25.0, 0), (L_MANGO - 50.0, 120), (L_MANGO - 80.0, 240)]:
    nicho_motor = Part.makeCylinder(D_HAPTIC_MOTOR / 2.0, 6.0)
    nicho_motor.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
    nicho_motor.translate(App.Vector(r1_top - 4.5, 0, z_pos))
    nicho_motor.rotate(App.Vector(0,0,0), App.Vector(0,0,1), ang_deg)
    mango_solido = mango_solido.cut(nicho_motor)

# 4. Cavidad del Pulsador SOS (en zona del pulgar superior)
boton_sos = Part.makeCylinder(6.0, 8.0)
boton_sos.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
boton_sos.translate(App.Vector(r1_top - 5.0, 0, L_MANGO - 15.0))
mango_solido = mango_solido.cut(boton_sos)

# 5. Torreta de Sensores Ultrasónicos (Parte media/inferior del Tramo 1)
# A. Sensor Frontal (2 ojos horizontales a 26 mm de centro)
ojo_f1 = Part.makeCylinder(D_ULTRASONIC_EYE / 2.0, 30.0)
ojo_f1.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
ojo_f1.translate(App.Vector(0, DIST_ULTRASONIC_EYES / 2.0, 85.0))

ojo_f2 = Part.makeCylinder(D_ULTRASONIC_EYE / 2.0, 30.0)
ojo_f2.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
ojo_f2.translate(App.Vector(0, -DIST_ULTRASONIC_EYES / 2.0, 85.0))
mango_solido = mango_solido.cut(ojo_f1).cut(ojo_f2)

# B. Sensor Suelo a 45 grados hacia el pavimento
ojo_s1 = Part.makeCylinder(D_ULTRASONIC_EYE / 2.0, 32.0)
ojo_s1.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
ojo_s1.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 45) # 45 grados abajo
ojo_s1.translate(App.Vector(0, DIST_ULTRASONIC_EYES / 2.0, 45.0))

ojo_s2 = Part.makeCylinder(D_ULTRASONIC_EYE / 2.0, 32.0)
ojo_s2.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
ojo_s2.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 45)
ojo_s2.translate(App.Vector(0, -DIST_ULTRASONIC_EYES / 2.0, 45.0))
mango_solido = mango_solido.cut(ojo_s1).cut(ojo_s2)

# C. Alojamiento para Servo SG90 (Radar Rotativo)
caja_servo = Part.makeBox(23.5, 13.0, 24.0)
caja_servo.translate(App.Vector(-11.75, -6.5, 115.0))
mango_solido = mango_solido.cut(caja_servo)

# Canal pasacables interior continuo hacia tramos inferiores
canal_cables_t1 = Part.makeCylinder(7.0, L_MANGO)
mango_solido = mango_solido.cut(canal_cables_t1)

# Hembra receptora en la base del Tramo 1 para recibir al Tramo 2
r_hembra_t1 = (D_T2_TOP / 2.0) - T_WALL_TUBOS + CLEARANCE_FIT
vaciado_hembra_t1 = Part.makeCylinder(r_hembra_t1, L_SOLAPE + 0.5)
mango_solido = mango_solido.cut(vaciado_hembra_t1)

# Asiento conico hembra 30 deg
cono_h_t1 = Part.makeCone(r1_bot + 0.5, r_hembra_t1, H_TAPER).translate(App.Vector(0, 0, -0.1))
mango_solido = mango_solido.cut(cono_h_t1)

# Taladro pasador pin en base de Tramo 1
pin_hole_t1 = Part.makeCylinder((D_PIN + CLEARANCE_PIN) / 2.0, 40.0)
pin_hole_t1.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
pin_hole_t1.translate(App.Vector(-20.0, 0, 22.0))
mango_solido = mango_solido.cut(pin_hole_t1)

tramo1_final = mango_solido

# =============================================================================
# 3. CONSTRUCCIÓN DE TRAMOS CÓNICOS DECRECIENTES (2, 3 Y 4)
# =============================================================================
print(">> Generando Tramos Conificados Decrecientes (Reducción de Inercia Pendular)...")

def fabricar_tramo_conico(d_sup, d_inf, longitud, r_macho_sup, r_hembra_inf, es_ultimo=False):
    """
    Construye un tramo cónico decreciente con:
     - Espiga macho superior reforzada con cono a 30°, garganta para O-Ring y canal pasacables.
     - Cuerpo cónico hueco (pared constante de 2.0 mm).
     - Hembra inferior para recibir al siguiente tramo.
    """
    r_sup = d_sup / 2.0
    r_inf = d_inf / 2.0
    
    # 1. Cuerpo cónico hueco
    cono_ext = Part.makeCone(r_inf, r_sup, longitud)
    cono_int = Part.makeCone(r_inf - T_WALL_TUBOS, r_sup - T_WALL_TUBOS, longitud)
    cuerpo = cono_ext.cut(cono_int)
    
    # 2. Espiga Macho Superior
    macho = Part.makeCylinder(r_macho_sup, L_SOLAPE)
    cono_asiento = Part.makeCone(r_sup, r_macho_sup, H_TAPER)
    cono_asiento.translate(App.Vector(0, 0, -H_TAPER))
    espiga_completa = macho.fuse(cono_asiento)
    
    # Garganta O-Ring en macho
    c_out = Part.makeCylinder(r_macho_sup + 1.5, 2.4)
    c_in = Part.makeCylinder(r_macho_sup - 1.35, 2.6).translate(App.Vector(0,0,-0.1))
    ranura_oring = c_out.cut(c_in).translate(App.Vector(0, 0, 10.0))
    espiga_completa = espiga_completa.cut(ranura_oring)
    
    # Canal pasacables interior en espiga
    r_cable_macho = r_macho_sup - T_WALL_TUBOS
    canal_macho = Part.makeCylinder(r_cable_macho, L_SOLAPE + H_TAPER + 2.0).translate(App.Vector(0,0,-H_TAPER - 1.0))
    espiga_completa = espiga_completa.cut(canal_macho)
    
    # Taladro pasador pin en macho
    taladro_m = Part.makeCylinder((D_PIN + CLEARANCE_PIN) / 2.0, (r_sup + 2.0) * 2.5)
    taladro_m.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
    taladro_m.translate(App.Vector(-(r_sup + 2.0) * 1.25, 0, 22.0))
    espiga_completa = espiga_completa.cut(taladro_m)
    
    # Posicionar espiga macho arriba del cuerpo
    espiga_completa.translate(App.Vector(0, 0, longitud))
    tramo_solido = cuerpo.fuse(espiga_completa)
    
    # 3. Hembra Receptora Inferior
    vaciado_h = Part.makeCylinder(r_hembra_inf, L_SOLAPE + 0.5)
    cono_h = Part.makeCone(r_inf + 0.5, r_hembra_inf, H_TAPER).translate(App.Vector(0,0,-0.1))
    
    taladro_h = Part.makeCylinder((D_PIN + CLEARANCE_PIN) / 2.0, (r_inf + 2.0) * 2.5)
    taladro_h.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
    taladro_h.translate(App.Vector(-(r_inf + 2.0) * 1.25, 0, 22.0))
    
    # Collarín de refuerzo anular exterior en la hembra
    collar = Part.makeCylinder(r_inf + 1.4, 10.0).translate(App.Vector(0, 0, 17.0))
    collar = collar.cut(Part.makeCylinder(r_inf - 0.1, 10.2).translate(App.Vector(0, 0, 16.9)))
    
    tramo_solido = tramo_solido.cut(vaciado_h).cut(cono_h).fuse(collar).cut(taladro_h)
    return tramo_solido

# Cálculo de radios de espigas macho y hembras
r_macho_t2 = ((D_MANGO_BOT / 2.0) - T_WALL_MANGO) - CLEARANCE_FIT # Acopla en Tramo 1
r_hembra_t2 = (D_T2_BOT / 2.0) - T_WALL_TUBOS

r_macho_t3 = r_hembra_t2 - CLEARANCE_FIT                           # Acopla en Tramo 2
r_hembra_t3 = (D_T3_BOT / 2.0) - T_WALL_TUBOS

r_macho_t4 = r_hembra_t3 - CLEARANCE_FIT                           # Acopla en Tramo 3
r_hembra_t4 = (D_T4_BOT / 2.0) - T_WALL_TUBOS

tramo2_final = fabricar_tramo_conico(D_T2_TOP, D_T2_BOT, L_TRAMO_2, r_macho_t2, r_hembra_t2)
tramo3_final = fabricar_tramo_conico(D_T3_TOP, D_T3_BOT, L_TRAMO_3, r_macho_t3, r_hembra_t3)
tramo4_final = fabricar_tramo_conico(D_T4_TOP, D_T4_BOT, L_TRAMO_4, r_macho_t4, r_hembra_t4, es_ultimo=True)

# =============================================================================
# 4. PUNTERA BUMPER CON DESACOPLE DE CHOQUE Y ACCESORIOS
# =============================================================================
print(">> Construyendo Puntera Amortiguadora y Pasadores...")

# Puntera amortiguadora (Domo esférico + Cámara de desacople)
r_puntera = D_T4_BOT / 2.0 # 7.0 mm
esfera_p = Part.makeSphere(10.5)
corte_p = Part.makeBox(25.0, 25.0, 25.0).translate(App.Vector(-12.5, -12.5, 0))
domo_puntera = esfera_p.cut(corte_p)
cuerpo_p = Part.makeCylinder(r_puntera, 20.0).fuse(domo_puntera)

# Espiga macho de puntera para Tramo 4
r_macho_puntera = r_hembra_t4 - CLEARANCE_FIT
espiga_p = Part.makeCylinder(r_macho_puntera, L_SOLAPE)
espiga_p.translate(App.Vector(0, 0, 20.0))

# Cámara acústica hueca de absorción de choque en el domo
camara_choque = Part.makeCylinder(5.0, 15.0).translate(App.Vector(0, 0, 3.0))

taladro_p = Part.makeCylinder((D_PIN + CLEARANCE_PIN) / 2.0, 30.0)
taladro_p.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
taladro_p.translate(App.Vector(-15.0, 0, 20.0 + 22.0))

puntera_final = cuerpo_p.fuse(espiga_p).cut(camara_choque).cut(taladro_p)

# Pasador Pin Calibrado de 5 mm
l_pin_total = (r1_top + 1.5) * 2.0 + 4.0
vastago_pin = Part.makeCylinder(D_PIN / 2.0, l_pin_total)
punta_pin = Part.makeCone(D_PIN / 2.0, (D_PIN / 2.0) - 1.0, 2.0).translate(App.Vector(0,0,l_pin_total - 2.0))
cabeza_pin = Part.makeCylinder((D_PIN / 2.0) + 2.5, 4.0).translate(App.Vector(0,0,-4.0))
pin_final = vastago_pin.fuse(punta_pin).fuse(cabeza_pin)

# Clip Detent en C
r_c_ext = (D_PIN / 2.0) + 2.0
r_c_int = (D_PIN / 2.0) - 0.35
cil_c_ext = Part.makeCylinder(r_c_ext, 1.2)
cil_c_int = Part.makeCylinder(r_c_int, 1.4).translate(App.Vector(0,0,-0.1))
corte_c = Part.makeBox(r_c_ext * 2, r_c_ext, 1.6).translate(App.Vector(0, -r_c_ext / 2.0, -0.2))
clip_final = cil_c_ext.cut(cil_c_int).cut(corte_c)

# =============================================================================
# 5. INTEGRACIÓN EN EL ÁRBOL FREECAD Y COLORIMETRÍA PROFESIONAL
# =============================================================================
COLOR_MANGO = (0.95, 0.95, 0.96)  # Blanco Técnico Puro (Mango y cerebro)
COLOR_T2    = (0.10, 0.35, 0.85)  # Azul Centinela
COLOR_T3    = (0.86, 0.15, 0.15)  # Rojo Tráfico RAL 3020 (Alerta Vial)
COLOR_T4    = (0.98, 0.98, 0.98)  # Blanco Señal Reflectivo
COLOR_PUNT  = (0.15, 0.15, 0.16)  # Grafito Basalto Antidesgaste
COLOR_PIN   = (0.96, 0.50, 0.10)  # Naranja Seguridad
COLOR_CLIP  = (0.18, 0.70, 0.28)  # Verde Técnico

# Alturas z acumuladas para ensamble exacto
z_t4 = 0.0
z_t3 = L_TRAMO_4
z_t2 = z_t3 + L_TRAMO_3
z_t1 = z_t2 + L_TRAMO_2

piezas_catalogo = [
    ("Tramo_1_Mango_Monolitico",  tramo1_final,  COLOR_MANGO, z_t1),
    ("Tramo_2_Intermedio_Alto",   tramo2_final,  COLOR_T2,    z_t2),
    ("Tramo_3_Intermedio_Alerta", tramo3_final,  COLOR_T3,    z_t3),
    ("Tramo_4_Inferior_Base",     tramo4_final,  COLOR_T4,    z_t4),
    ("Puntera_Bumper_Amortiguada",puntera_final, COLOR_PUNT,  -20.0),
    ("Pasador_Pin_Seguridad",     pin_final,     COLOR_PIN,   -99.0),
    ("Clip_Detent_Retencion",     clip_final,    COLOR_CLIP,  -99.0),
]

objetos_para_export = []

for nombre, shape, color, z_coord in piezas_catalogo:
    obj = doc.addObject("Part::Feature", nombre)
    obj.Shape = shape
    
    if z_coord >= 0:
        obj.Placement.Base = App.Vector(0, 0, z_coord)
    elif z_coord == -20.0:
        obj.Placement.Base = App.Vector(0, 0, -20.0)
    else:
        if "Pin" in nombre:
            obj.Placement.Base = App.Vector(D_MANGO_TOP * 1.5, 0, 100)
            obj.Placement.Rotation = App.Rotation(App.Vector(0, 1, 0), 90)
        elif "Clip" in nombre:
            obj.Placement.Base = App.Vector(D_MANGO_TOP * 1.5, 20, 100)
            
    if App.GuiUp:
        obj.ViewObject.ShapeColor = color
        obj.ViewObject.DisplayMode = "Shaded"
        obj.ViewObject.LineWidth = 1.0
        
    objetos_para_export.append((nombre, obj))

doc.recompute()

# =============================================================================
# 6. EXPORTACIÓN DE ENTREGABLES INDUSTRIALES (.FCStd, .STL, .STEP)
# =============================================================================
print(">> Exportando entregables de fabricación a: {}".format(DIR_CAD))

# 1. Documento Nativo FreeCAD
ruta_fcstd = os.path.join(DIR_CAD, "Centinela_v2_Monolitico_Final.FCStd")
doc.saveAs(ruta_fcstd)
print("   -> [OK] Documento Nativo FreeCAD: {}".format(ruta_fcstd))

# 2. Mallas STL individuales para impresión 3D
if Mesh:
    for nombre, obj in objetos_para_export:
        ruta_stl = os.path.join(DIR_CAD, "{}.stl".format(nombre))
        try:
            msh = doc.addObject("Mesh::Feature", nombre + "_Mesh")
            msh.Mesh = Mesh.Mesh(obj.Shape.tessellate(0.06))
            Mesh.export([msh], ruta_stl)
            doc.removeObject(msh.Name)
            print("   -> [OK] STL Exportado: {}".format(ruta_stl))
        except Exception as e:
            print("   -> [AVISO] Fallo STL {}: {}".format(nombre, e))

# 3. Ensamble STEP AP214 en colores
ruta_step = os.path.join(DIR_CAD, "Baston_Centinela_v2_Monolitico.step")
try:
    Part.export([obj for nombre, obj in objetos_para_export if "Pin" not in nombre and "Clip" not in nombre], ruta_step)
    print("   -> [OK] STEP de Ensamble Exportado: {}".format(ruta_step))
except Exception as e:
    print("   -> [AVISO] Fallo STEP: {}".format(e))

if App.GuiUp:
    import FreeCADGui as Gui
    Gui.SendMsgToActiveView("ViewAxo")
    Gui.SendMsgToActiveView("ViewFit")

print("===============================================================================")
print(" MODELO MONOLÍTICO CENTINELA v2 COMPLETADO")
print("  - Mango ergonómico monolítico con bahía 2S Li-Ion, ESP32, 3 motores y GPS.")
print("  - Torreta de sensores integrada: Frontal + Suelo 45° + Radar Servo SG90.")
print("  - Perfil cónico decreciente: Ø 32 mm en mano -> Ø 14 mm en punta.")
print("  - Desacople acústico y mecánico contra vibraciones urbanas severas.")
print("===============================================================================")
