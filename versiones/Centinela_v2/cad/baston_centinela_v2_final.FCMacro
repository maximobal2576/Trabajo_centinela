# -*- coding: utf-8 -*-
"""
===============================================================================
PROYECTO CENTINELA v2 - BASTÓN TÉCNICO INTELIGENTE DE ALTA RESISTENCIA
SISTEMA PARAMÉTRICO DE PRODUCCIÓN INDUSTRIAL PARA FREECAD (.FCMacro)
===============================================================================
Ingeniería de Producto y Condiciones Severas de Intemperie:
 - Protección UV y Resistencia Térmica: Polímeros PA12-CF / ASA
 - Estanqueidad IP65 contra Lluvia: O-ring NBR 70 Shore integrado en cada unión
 - Drenaje por Gravedad (Shingle Effect): Enchufe hembra descendente anti-filtración
 - Asiento Cónico Antidesgaste 30° (Taper-Lock): Cero juego mecánico en la mano
 - Estrías de Bloqueo Antirrotación: Protege al pasador de esfuerzos de torsión
 - Ruteo Seco para BMS 2S y Baterías 18650: Canal central continuo de 14.2 mm
===============================================================================
"""

import FreeCAD as App
import Part
import math
import os

try:
    import Mesh
except ImportError:
    Mesh = None

# =============================================================================
# 1. PARÁMETROS GLOBALES DE INGENIERÍA
# =============================================================================
L_TOTAL               = 1200.0   # Longitud efectiva ensamblada en servicio (mm)
N_TRAMOS              = 4        # Número de tramos iguales
D_EXTERIOR            = 24.0     # Diámetro exterior liso ergonómico (mm)
T_WALL                = 2.4      # Espesor estructural optimizado para FDM/SLS (mm)

# Rigidez a Flexión (Ixx) e Impacto
N_RIBS                = 4        # Cantidad de nervios longitudinales internos
RIB_HEIGHT            = 1.2      # Altura radial del nervio (mm)
RIB_THICKNESS         = 1.2      # Espesor del nervio (mm)

# Acoplamiento Macho-Hembra y Taper-Lock
L_OVERLAP             = 42.0     # Solape axial de acoplamiento (mm)
CLEARANCE_FIT         = 0.30     # Holgura radial calibrada para PA12/ASA (mm)
H_TAPER               = 3.0      # Altura del cono de autocentrado a 30 grados (mm)

# Estrías Antirrotación (Anti-Torsion Splines)
N_SPLINES             = 4        # 4 chavetas a 45 grados alternadas con nervios
SPLINE_W              = 2.0      # Ancho tangencial de la chaveta (mm)
SPLINE_H              = 0.9      # Altura radial de la chaveta (mm)
SPLINE_L              = 18.0     # Longitud axial de la chaveta (mm)

# Estanqueidad IP65 contra Lluvia
ORING_W               = 2.4      # Ancho del canal para tórica NBR de 2.0 mm (mm)
ORING_D               = 1.35     # Profundidad del canal (compresión 28%) (mm)
ORING_Z               = 12.0     # Distancia Z desde el hombro del macho (mm)

# Pasador Pin de Seguridad
D_PIN                 = 5.0      # Diámetro nominal del pasador (mm)
CLEARANCE_PIN         = 0.25     # Holgura diametral compensada para FDM (mm)
PIN_Z                 = 27.0     # Cota Z del pasador respecto al hombro (mm)
COLLAR_ADD            = 1.5      # Refuerzo anular exterior en la hembra (mm)

# Canal Eléctrico Seguro Centinela (2S Li-Ion + BMS)
D_CABLE_CH            = 14.2     # Diámetro interior libre continuo (mm)

# Puntera de Impacto y Sacrificio
L_PUNTERA_EXPOSED     = 32.0     # Longitud expuesta del bumper de contacto (mm)
R_PUNTERA_DOME        = 13.5     # Radio de curvatura del domo de asfalto (mm)

# Cálculos Derivados
R_EXT                 = D_EXTERIOR / 2.0                       # 12.0 mm
R_INT                 = R_EXT - T_WALL                         # 9.60 mm
R_MACHO               = R_INT - CLEARANCE_FIT                  # 9.30 mm
R_CABLE               = D_CABLE_CH / 2.0                       # 7.10 mm
R_HOLE                = (D_PIN + CLEARANCE_PIN) / 2.0          # 2.625 mm
L_EFF_TRAMO           = L_TOTAL / float(N_TRAMOS)              # 300.0 mm

# Rutas de Salida
DIR_CAD = os.path.dirname(os.path.abspath(__file__)) if "__file__" in locals() else "C:\\Users\\admin\\Documents\\proyecto innovador\\versiones\\Centinela_v2\\cad"
if not os.path.exists(DIR_CAD):
    os.makedirs(DIR_CAD)

print(">> Inicializando Construcción de Geometría Centinela v2...")

# =============================================================================
# 2. CREACIÓN DEL DOCUMENTO Y HOJA DE CÁLCULO
# =============================================================================
DOC_NAME = "Centinela_v2_Hardware_Final"
try:
    App.closeDocument(DOC_NAME)
except Exception:
    pass

doc = App.newDocument(DOC_NAME)
App.setActiveDocument(DOC_NAME)

sheet = doc.addObject("Spreadsheet::Sheet", "Parametros_Centinela")

tabla_datos = [
    (2,  "Longitud_Total",        "L_total",        str(L_TOTAL),       "mm - Longitud en servicio"),
    (3,  "Tramos_Modulares",      "N_tramos",       str(N_TRAMOS),      "unidades - Secciones iguales"),
    (4,  "Diametro_Exterior",     "D_ext",          str(D_EXTERIOR),    "mm - Tubo exterior liso"),
    (5,  "Espesor_Pared",         "t_wall",         str(T_WALL),        "mm - Espesor FDM/SLS"),
    (7,  "Nervios_Rigidez_Ixx",   "N_ribs",         str(N_RIBS),        "unidades - Cruz interna"),
    (8,  "Altura_Nervio",         "rib_h",          str(RIB_HEIGHT),    "mm - Altura radial"),
    (9,  "Espesor_Nervio",        "rib_t",          str(RIB_THICKNESS), "mm - Espesor tangencial"),
    (11, "Solape_Acople",         "L_overlap",      str(L_OVERLAP),     "mm - Longitud espiga"),
    (12, "Holgura_Radial",        "clearance_fit",  str(CLEARANCE_FIT), "mm - Ajuste con intemperie"),
    (13, "Asiento_Conico_30deg",  "h_taper",        str(H_TAPER),       "mm - Taper-Lock anti-juego"),
    (15, "Ancho_Canal_Oring",     "oring_w",        str(ORING_W),       "mm - Tórica NBR 2.0mm"),
    (16, "Prof_Canal_Oring",      "oring_d",        str(ORING_D),       "mm - Compresion IP65"),
    (18, "Diametro_Pasador",      "d_pin",          str(D_PIN),         "mm - Pin cilindrico"),
    (19, "Holgura_Taladro_Pin",   "clearance_pin",  str(CLEARANCE_PIN), "mm - FDM compensado"),
    (20, "Refuerzo_Collar_Pin",   "collar_add",     str(COLLAR_ADD),    "mm - Espesor anti-cizalla"),
    (22, "Canal_Cables_BMS_2S",   "d_cable",        str(D_CABLE_CH),    "mm - Paso libre 7.4V seco"),
]

sheet.set("A1", "PARÁMETRO INDUSTRIAL")
sheet.set("B1", "VALOR")
sheet.set("C1", "CRITERIO DE INGENIERÍA / UNIDAD")

sheet.set("A6",  "--- RIGIDEZ MECANICA ---")
sheet.set("A10", "--- ACOPLE Y TAPER-LOCK ---")
sheet.set("A14", "--- ESTANQUEIDAD IP65 LLUVIA ---")
sheet.set("A17", "--- PASADOR DE RETENCION ---")
sheet.set("A21", "--- ELECTRONICA CENTINELA ---")

for r, nom, alias, val, desc in tabla_datos:
    sheet.set("A{}".format(r), nom)
    sheet.set("B{}".format(r), val)
    sheet.set("C{}".format(r), desc)
    sheet.setAlias("B{}".format(r), alias)

if App.GuiUp:
    sheet.setBackground("A1:C1", (0.08, 0.18, 0.32, 1.0))
    sheet.setForeground("A1:C1", (1.0, 1.0, 1.0, 1.0))
    sheet.setStyle("A1:C1", "bold", "add")
    for s_r in [6, 10, 14, 17, 21]:
        rng = "A{}:C{}".format(s_r, s_r)
        sheet.setBackground(rng, (0.88, 0.92, 0.97, 1.0))
        sheet.setStyle(rng, "bold", "add")

# =============================================================================
# 3. GENERADORES DE GEOMETRÍA CSG
# =============================================================================

def fabricar_tubo_con_nervaduras(longitud):
    """Crea tubo liso exterior con 4 nervios longitudinales internos en cruz."""
    t_ext = Part.makeCylinder(R_EXT, longitud)
    t_int = Part.makeCylinder(R_INT, longitud)
    tubo = t_ext.cut(t_int)

    for i in range(N_RIBS):
        ang = i * (360.0 / N_RIBS)
        rib = Part.makeBox(RIB_HEIGHT + 0.1, RIB_THICKNESS, longitud)
        rib.translate(App.Vector(R_INT - RIB_HEIGHT, -RIB_THICKNESS / 2.0, 0))
        rib.rotate(App.Vector(0,0,0), App.Vector(0,0,1), ang)
        tubo = tubo.fuse(rib)
        
    return tubo


def fabricar_espiga_macho():
    """
    Construye la espiga macho con:
     1. Asiento cónico a 30° antidesgaste (Taper-Lock).
     2. 4 chavetas longitudinales antirrotación.
     3. Garganta para O-ring NBR (sellado IP65).
     4. Taladro pasante del pasador.
     5. Canal pasacables central continuo de 14.2 mm.
    """
    cil_macho = Part.makeCylinder(R_MACHO, L_OVERLAP)
    
    # Asiento cónico
    cono = Part.makeCone(R_EXT, R_MACHO, H_TAPER)
    cono.translate(App.Vector(0, 0, -H_TAPER))
    macho = cil_macho.fuse(cono)
    
    # 4 Chavetas longitudinales antirrotación a 45 grados de los nervios
    for i in range(N_SPLINES):
        ang = 45.0 + i * (360.0 / N_SPLINES)
        sp = Part.makeBox(SPLINE_H + 0.1, SPLINE_W, SPLINE_L)
        sp.translate(App.Vector(R_MACHO - 0.1, -SPLINE_W / 2.0, 3.0))
        sp.rotate(App.Vector(0,0,0), App.Vector(0,0,1), ang)
        macho = macho.fuse(sp)
        
    # Garganta mecanizada para O-Ring
    c_out = Part.makeCylinder(R_MACHO + 2.0, ORING_W)
    c_in = Part.makeCylinder(R_MACHO - ORING_D, ORING_W + 0.2).translate(App.Vector(0, 0, -0.1))
    anillo_oring = c_out.cut(c_in).translate(App.Vector(0, 0, ORING_Z))
    macho = macho.cut(anillo_oring)
    
    # Canal pasacables interior continuo
    conduit = Part.makeCylinder(R_CABLE, L_OVERLAP + H_TAPER + 4.0)
    conduit.translate(App.Vector(0, 0, -H_TAPER - 2.0))
    macho = macho.cut(conduit)
    
    # Taladro pasante del pin
    taladro = Part.makeCylinder(R_HOLE, (R_EXT + COLLAR_ADD) * 2.5)
    taladro.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
    taladro.translate(App.Vector(-(R_EXT + COLLAR_ADD) * 1.25, 0, PIN_Z))
    macho = macho.cut(taladro)
    
    return macho


def aplicar_hembra_receptora(cuerpo_tubo):
    """
    Mecaniza la recepción hembra con:
     1. Escariado interno que libera nervios para recibir la espiga.
     2. Asiento cónico hembra a 30° con labio deflector escurridor de lluvia.
     3. 4 ranuras para las chavetas antirrotación.
     4. Collar anular exterior de refuerzo alrededor del taladro del pin.
    """
    # Escariado interior
    escariado = Part.makeCylinder(R_INT, L_OVERLAP + 0.5)
    cuerpo = cuerpo_tubo.cut(escariado)
    
    # Asiento cónico hembra
    cono_hembra = Part.makeCone(R_EXT + 0.5, R_MACHO, H_TAPER)
    cono_hembra.translate(App.Vector(0, 0, -0.1))
    cuerpo = cuerpo.cut(cono_hembra)
    
    # 4 Ranuras antirrotación
    for i in range(N_SPLINES):
        ang = 45.0 + i * (360.0 / N_SPLINES)
        grv = Part.makeBox(SPLINE_H + 0.35, SPLINE_W + 0.4, SPLINE_L + 2.0)
        grv.translate(App.Vector(R_INT - 0.2, -(SPLINE_W + 0.4) / 2.0, 2.5))
        grv.rotate(App.Vector(0,0,0), App.Vector(0,0,1), ang)
        cuerpo = cuerpo.cut(grv)
        
    # Taladro coaxial del pasador
    taladro = Part.makeCylinder(R_HOLE, (R_EXT + COLLAR_ADD) * 2.5)
    taladro.rotate(App.Vector(0,0,0), App.Vector(0,1,0), 90)
    taladro.translate(App.Vector(-(R_EXT + COLLAR_ADD) * 1.25, 0, PIN_Z))
    
    # Collar anular envolvente de refuerzo
    collar = Part.makeCylinder(R_EXT + COLLAR_ADD, 10.0).translate(App.Vector(0, 0, PIN_Z - 5.0))
    collar_ring = collar.cut(Part.makeCylinder(R_EXT - 0.1, 10.2).translate(App.Vector(0, 0, PIN_Z - 5.1)))
    cuerpo = cuerpo.fuse(collar_ring).cut(taladro)
    
    return cuerpo


def fabricar_puntera_bumper():
    """
    Puntera de desgaste con domo esférico continuo, amortiguador interno
    y espiga con O-ring de retención.
    """
    # Domo esférico
    esfera = Part.makeSphere(R_PUNTERA_DOME)
    corte_plano = Part.makeBox(R_PUNTERA_DOME * 3, R_PUNTERA_DOME * 3, R_PUNTERA_DOME)
    corte_plano.translate(App.Vector(-R_PUNTERA_DOME * 1.5, -R_PUNTERA_DOME * 1.5, 0))
    domo = esfera.cut(corte_plano)
    
    cuerpo_cil = Part.makeCylinder(R_EXT, L_PUNTERA_EXPOSED)
    bumper = cuerpo_cil.fuse(domo)
    
    # Espiga macho de montaje
    espiga = fabricar_espiga_macho()
    espiga.translate(App.Vector(0, 0, L_PUNTERA_EXPOSED))
    
    # Cavidad de amortiguación interna
    camara_choque = Part.makeCylinder(R_CABLE, L_PUNTERA_EXPOSED - 5.0).translate(App.Vector(0, 0, 5.0))
    puntera = bumper.fuse(espiga).cut(camara_choque)
    
    return puntera


def fabricar_pin_seguridad():
    """Pasador de bloqueo rápido con cabeza ergonómica estriada y ranura detent."""
    l_pin = (R_EXT + COLLAR_ADD) * 2.0 + 5.0 # 32 mm
    
    vastago = Part.makeCylinder(D_PIN / 2.0, l_pin)
    punta_guia = Part.makeCone(D_PIN / 2.0, (D_PIN / 2.0) - 1.0, 2.0).translate(App.Vector(0, 0, l_pin - 2.0))
    cabeza = Part.makeCylinder((D_PIN / 2.0) + 2.5, 4.5).translate(App.Vector(0, 0, -4.5))
    
    # Ranura para clip elástico
    ranura = Part.makeCylinder((D_PIN / 2.0) + 0.1, 1.2)
    ranura = ranura.cut(Part.makeCylinder((D_PIN / 2.0) - 0.6, 1.4)).translate(App.Vector(0, 0, l_pin - 3.8))
    
    return vastago.fuse(punta_guia).fuse(cabeza).cut(ranura)


def fabricar_clip_detent():
    """Clip elástico en C tipo detent para enclavamiento instantáneo del pin."""
    r_c_ext = (D_PIN / 2.0) + 2.0
    r_c_int = (D_PIN / 2.0) - 0.35
    espesor = 1.2
    
    cil_ext = Part.makeCylinder(r_c_ext, espesor)
    cil_int = Part.makeCylinder(r_c_int, espesor + 0.2).translate(App.Vector(0, 0, -0.1))
    anillo = cil_ext.cut(cil_int)
    
    apertura = Part.makeBox(r_c_ext * 2, r_c_ext, espesor + 0.4)
    apertura.translate(App.Vector(0, -r_c_ext / 2.0, -0.2))
    
    return anillo.cut(apertura)

# =============================================================================
# 4. CONSTRUCCIÓN DE LAS PIEZAS ESTRUCTURALES DEL BASTÓN
# =============================================================================
print(">> Construyendo sólidos de los 4 tramos y puntera...")

# Sentido gravitatorio shingle:
# La hembra apunta hacia ABAJO (actúa como tejado escurridor de lluvia).
# El macho apunta hacia ARRIBA (entra dentro de la hembra superior).

# --- TRAMO 4: INFERIOR / BASE ---
# Arriba: Macho para conectar con Tramo 3.
# Abajo: Hembra para recibir la Puntera.
t4_tubo = fabricar_tubo_con_nervaduras(L_EFF_TRAMO)
t4_hembra_puntera = aplicar_hembra_receptora(t4_tubo)
t4_macho_sup = fabricar_espiga_macho()
t4_macho_sup.translate(App.Vector(0, 0, L_EFF_TRAMO))
tramo4_solid = t4_hembra_puntera.fuse(t4_macho_sup)

# --- TRAMO 3: INTERMEDIO BAJO (Franja de Seguridad Vial) ---
# Arriba: Macho para conectar con Tramo 2.
# Abajo: Hembra receptora para Tramo 4.
t3_tubo = fabricar_tubo_con_nervaduras(L_EFF_TRAMO)
t3_hembra = aplicar_hembra_receptora(t3_tubo)
t3_macho = fabricar_espiga_macho()
t3_macho.translate(App.Vector(0, 0, L_EFF_TRAMO))
tramo3_solid = t3_hembra.fuse(t3_macho)

# --- TRAMO 2: INTERMEDIO ALTO ---
# Arriba: Macho para conectar con Tramo 1.
# Abajo: Hembra receptora para Tramo 3.
t2_tubo = fabricar_tubo_con_nervaduras(L_EFF_TRAMO)
t2_hembra = aplicar_hembra_receptora(t2_tubo)
t2_macho = fabricar_espiga_macho()
t2_macho.translate(App.Vector(0, 0, L_EFF_TRAMO))
tramo2_solid = t2_hembra.fuse(t2_macho)

# --- TRAMO 1: SUPERIOR (Interfaz Mango + Batería 2S + BMS) ---
# Arriba: Tubo abierto para interfaz de mango.
# Abajo: Hembra receptora para Tramo 2.
t1_tubo = fabricar_tubo_con_nervaduras(L_EFF_TRAMO)
tramo1_solid = aplicar_hembra_receptora(t1_tubo)

# --- PIEZAS ACCESORIAS ---
puntera_solid = fabricar_puntera_bumper()
pin_solid     = fabricar_pin_seguridad()
clip_solid    = fabricar_clip_detent()

# =============================================================================
# 5. ASIGNACIÓN AL ÁRBOL DE FREECAD CON COLORIMETRÍA INDUSTRIAL
# =============================================================================
COLOR_T1   = (0.95, 0.95, 0.96)  # Blanco Técnico Puro (Mango y control)
COLOR_T2   = (0.10, 0.35, 0.85)  # Azul Centinela (Identidad de ingeniería)
COLOR_T3   = (0.86, 0.15, 0.15)  # Rojo Tráfico RAL 3020 (Señalización vial)
COLOR_T4   = (0.98, 0.98, 0.98)  # Blanco Señal Reflectante (Contraste asfalto)
COLOR_PUNT = (0.15, 0.15, 0.16)  # Grafito Basalto Antidesgaste (POM/TPU)
COLOR_PIN  = (0.96, 0.50, 0.10)  # Naranja Seguridad RAL 2004 (Fácil inspección)
COLOR_CLIP = (0.18, 0.70, 0.28)  # Verde Técnico Retención

catalogo = [
    ("Tramo_1_Superior",        tramo1_solid,  COLOR_T1,   3.0),
    ("Tramo_2_Intermedio_Alto", tramo2_solid,  COLOR_T2,   2.0),
    ("Tramo_3_Intermedio_Alerta",tramo3_solid, COLOR_T3,   1.0),
    ("Tramo_4_Inferior_Base",   tramo4_solid,  COLOR_T4,   0.0),
    ("Puntera_Bumper_Impacto",  puntera_solid, COLOR_PUNT, -1.0),
    ("Pasador_Pin_Seguridad",   pin_solid,     COLOR_PIN,  -99.0),
    ("Clip_Detent_Retencion",   clip_solid,    COLOR_CLIP, -99.0),
]

objetos_para_exportar = []

for nombre, solid, color, z_mult in catalogo:
    obj = doc.addObject("Part::Feature", nombre)
    obj.Shape = solid
    
    # Posicionamiento en el espacio ensamblado
    if z_mult >= 0:
        obj.Placement.Base = App.Vector(0, 0, z_mult * L_EFF_TRAMO)
    elif z_mult == -1.0:
        # Puntera justo en la base
        obj.Placement.Base = App.Vector(0, 0, -L_PUNTERA_EXPOSED)
    else:
        # Accesorios mostrados al costado para inspección visual
        if "Pin" in nombre:
            obj.Placement.Base = App.Vector(R_EXT * 3.5, 0, 100)
            obj.Placement.Rotation = App.Rotation(App.Vector(0, 1, 0), 90)
        elif "Clip" in nombre:
            obj.Placement.Base = App.Vector(R_EXT * 3.5, 20, 100)
            
    if App.GuiUp:
        obj.ViewObject.ShapeColor = color
        obj.ViewObject.DisplayMode = "Shaded"
        obj.ViewObject.LineWidth = 1.2
        
    objetos_para_exportar.append((nombre, obj))

doc.recompute()

# =============================================================================
# 6. EXPORTACIÓN AUTOMÁTICA DE ARCHIVOS (STL, STEP Y FCSTD)
# =============================================================================
print(">> Exportando archivos industriales a: {}".format(DIR_CAD))

# 1. Guardar documento nativo FreeCAD (.FCStd)
ruta_fcstd = os.path.join(DIR_CAD, "Centinela_v2_Ensamblado.FCStd")
doc.saveAs(ruta_fcstd)
print("   -> [OK] Documento Nativo Guardado: {}".format(ruta_fcstd))

# 2. Exportar STLs individuales si el módulo Mesh está disponible
if Mesh:
    for nombre, obj in objetos_para_exportar:
        ruta_stl = os.path.join(DIR_CAD, "{}.stl".format(nombre))
        try:
            msh = doc.addObject("Mesh::Feature", nombre + "_Mesh")
            msh.Mesh = Mesh.Mesh(obj.Shape.tessellate(0.06)) # Malla de alta resolución
            Mesh.export([msh], ruta_stl)
            doc.removeObject(msh.Name)
            print("   -> [OK] STL Generado: {}".format(ruta_stl))
        except Exception as e:
            print("   -> [AVISO] No se pudo exportar {}: {}".format(nombre, e))

# 3. Exportar STEP de ensamble completo (AP214 con colores para cualquier CAD)
ruta_step = os.path.join(DIR_CAD, "Baston_Centinela_v2_Completo.step")
try:
    Part.export([obj for nombre, obj in objetos_para_exportar if "Pin" not in nombre and "Clip" not in nombre], ruta_step)
    print("   -> [OK] Ensamble STEP Exportado: {}".format(ruta_step))
except Exception as e:
    print("   -> [AVISO] Error al exportar STEP: {}".format(e))

if App.GuiUp:
    import FreeCADGui as Gui
    Gui.SendMsgToActiveView("ViewAxo")
    Gui.SendMsgToActiveView("ViewFit")

print("===============================================================================")
print(" DISEÑO MAESTRO CENTINELA v2 CONSOLIDADO CON ÉXITO")
print("  - Longitud ensamblada: {} mm | Tramos: {} de {} mm".format(L_TOTAL, N_TRAMOS, L_EFF_TRAMO))
print("  - Diámetro exterior: {} mm  | Canal de cables seco: {} mm".format(D_EXTERIOR, D_CABLE_CH))
print("  - Grado de protección: IP65 con O-ring NBR y efecto teja anti-lluvia")
print("===============================================================================")
